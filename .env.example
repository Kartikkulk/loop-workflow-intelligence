# ─── LLM ────────────────────────────────────────────────────────────────────
# Optional. With no key, every LLM-backed feature falls back to a deterministic
# heuristic so the full demo still runs end to end. Set it for richer output.
ANTHROPIC_API_KEY=
# Model used for structured generation (flow defs, SOPs, drift remapping).
LOOP_LLM_MODEL=claude-sonnet-5
# Cache LLM responses on prompt hash. Keep on during a hackathon: you will
# re-run the same analysis fifty times.
LOOP_LLM_CACHE=true

# ─── Database ───────────────────────────────────────────────────────────────
# Default is SQLite: zero infrastructure, works immediately.
# For Postgres: postgresql+asyncpg://loop:loop@localhost:5432/loop
LOOP_DATABASE_URL=sqlite+aiosqlite:///./loop.db

# ─── Detection tuning (F2 — Workflow DNA) ───────────────────────────────────
# Idle gap that ends a task instance, in minutes.
LOOP_SESSION_GAP_MINUTES=15
# Fuzzy-clustering acceptance threshold on the combined similarity score.
LOOP_CLUSTER_THRESHOLD=0.82
# Combined similarity = SEQ_WEIGHT * levenshtein + (1-SEQ_WEIGHT) * embedding.
LOOP_SEQUENCE_WEIGHT=0.6
# A cluster performed by more than this many distinct users is promoted to an
# organisational opportunity.
LOOP_ORG_USER_THRESHOLD=3

# ─── Scoring (F3) ───────────────────────────────────────────────────────────
# Minutes of real cost per context switch. The literature says 4-23; we are
# deliberately conservative.
LOOP_INTERRUPTION_COST_MINUTES=4
# Window in which an A -> B -> A app bounce counts as one context switch.
LOOP_CONTEXT_SWITCH_WINDOW_MINUTES=10
# Clusters scoring below this automatability are flagged DO NOT AUTOMATE.
LOOP_DO_NOT_AUTOMATE_THRESHOLD=0.4
# Working weeks per year, used for annual-hours projection.
LOOP_WORKING_WEEKS=48

# ─── Trust ladder (F7) ──────────────────────────────────────────────────────
LOOP_SHADOW_WINDOW=5
LOOP_SHADOW_PROMOTION_THRESHOLD=0.90
LOOP_SHADOW_MIN_RUNS=5
# A critical mismatch inside this many recent runs forces a demotion.
LOOP_DEMOTION_LOOKBACK=3

# ─── Execution engine (F5) ──────────────────────────────────────────────────
# Mock connectors have no side effects. Never set false without real creds.
LOOP_ENABLE_MOCK_CONNECTORS=true

# ─── Self-healing (F8) ──────────────────────────────────────────────────────
# Drift patches at or above this confidence auto-apply, if non-destructive.
LOOP_PATCH_AUTO_APPLY_CONFIDENCE=0.9
# Similar exceptions needed before a branch rule is proposed.
LOOP_EXCEPTION_RULE_MIN_SAMPLES=3

# ─── Seed data ──────────────────────────────────────────────────────────────
LOOP_SEED=42
LOOP_SEED_DAYS=90

# ─── Frontend ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE=http://localhost:8000
