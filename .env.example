# LOOP — copy this to .env. You do not have to change anything in it.
#
# Every value below is the default the code already uses. This file exists so
# you can see what is changeable and override one thing, not so you can fill
# it in before starting.

# ── AI ──────────────────────────────────────────────────────────────────────
# Local model through Ollama, asked first every time (`ollama pull qwen3:8b`).
# If it cannot answer, the OpenAI key below is a second chance; with neither,
# every feature falls back to a heuristic. Never commit a real key.
LOOP_LLM_PROVIDER=ollama
LOOP_LLM_MODEL=qwen3:8b
LOOP_OLLAMA_BASE_URL=http://localhost:11434
LOOP_OPENAI_API_KEY=
LOOP_OPENAI_MODEL=gpt-4o-mini

# ── discovery sensitivity ────────────────────────────────────────────────────
# "demo" lets a task done just 2-3 times be discovered (labelled early/moderate,
# preview-only, never auto-executed); "production" keeps the full floor. Demo
# lowers discovery thresholds ONLY — guards, validation and approval are
# unchanged. The similarity/confidence gates live in config.py.
LOOP_DISCOVERY_MODE=demo
LOOP_DISCOVERY_MIN_OCCURRENCES=2
LOOP_DISCOVERY_STRONG_OCCURRENCES=5

# Reading screen recordings needs a model that can see. Empty turns that one
# feature off; `ollama pull llama3.2-vision` and name it here to turn it on.
LOOP_OLLAMA_VISION_MODEL=

# ── storage ─────────────────────────────────────────────────────────────────
# SQLite, in apps/api/. Delete the file to start over, or `make reset-db`.
LOOP_DATABASE_URL=sqlite+aiosqlite:///./loop.db

# ── where LOOP runs ─────────────────────────────────────────────────────────
# Change only if you moved a port. The API URL has to match the redirect URI
# you register with Google or Microsoft, exactly, including the port.
LOOP_API_BASE_URL=http://localhost:8000
LOOP_CONSOLE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE=http://localhost:8000

# ── safety ──────────────────────────────────────────────────────────────────
# ⚠ Mock connectors have no side effects at all. Set this false and `live`
#   mode genuinely sends email and writes to systems of record. Replay and
#   shadow force mocks whatever this says — that guarantee is in the engine,
#   not in this variable.
LOOP_ENABLE_MOCK_CONNECTORS=true

# ── connecting your own accounts ────────────────────────────────────────────
# Normally done in the app (Sources → Connect your accounts), which stores what
# you type in the local database. You may set the OAuth pairs here instead:
#   LOOP_GOOGLE_/MS_/ATLASSIAN_/SLACK_ CLIENT_ID and _CLIENT_SECRET
# ⚠ Never commit a filled-in copy — a connected account holds a live token.

# ── running automations, and the files they touch ───────────────────────────
# Create the key in n8n (Settings > n8n API); empty means export is off.
LOOP_N8N_API_KEY=
LOOP_FILES_ROOT=~/Kriya-Invoices
# Nothing moves while this is true — steps report what they would have done:
LOOP_FILES_DRY_RUN=true

# ── letting an automation write to Jira ─────────────────────────────────────
# Its own token, separate from the read-only OAuth connection above. Create one
# at https://id.atlassian.com/manage-profile/security/api-tokens, then set
# LOOP_JIRA_SITE_URL / LOOP_JIRA_EMAIL / LOOP_JIRA_API_TOKEN.
# Nothing is filed while this is true — steps report what they would have done:
LOOP_JIRA_DRY_RUN=true
# Projects an automation may file into. Empty means none.
LOOP_JIRA_ALLOWED_PROJECTS=

# ── everything else ─────────────────────────────────────────────────────────
# Detection thresholds, scoring weights, trust-ladder rules and the seed all
# live in apps/api/app/config.py, each with the reason for its value written
# next to it. They were chosen by measurement, so change them there — where
# the reasoning is — rather than guessing at a number here.
