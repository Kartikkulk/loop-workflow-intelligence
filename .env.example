# ════════════════════════════════════════════════════════════════════════════
#  LOOP — configuration
#
#  YOU DO NOT NEED TO CHANGE ANYTHING IN HERE TO RUN THE PROJECT.
#
#      cp .env.example .env && make setup && make demo && make dev
#
#  No API key, no database server, no Docker, no cloud account. Every value
#  below already holds its default, so an empty .env behaves identically to
#  this file. Copy it anyway — some tools expect .env to exist.
#
#  Everything is read by app/config.py. If you add a setting there, add it here
#  too: `make check` fails when the two drift apart.
# ════════════════════════════════════════════════════════════════════════════


# ─── 1. AI · optional ───────────────────────────────────────────────────────
#
# LOOP runs completely without this. Every AI-backed feature has a
# deterministic fallback, so with no key you still get flow generation, SOPs,
# variance scoring, drift remapping and rule learning — just from heuristics
# rather than from a model.
#
# Set a key only if you want richer wording. The one thing that genuinely
# cannot work without it is reading screen-recording frames, and the app says
# so rather than pretending.

ANTHROPIC_API_KEY=

# Model used for structured generation. Ignored when there is no key.
#
# A full demo cycle is roughly 14 calls, ~9.8k input and ~7k output tokens:
#
#   claude-opus-5     $5 / $25 per Mtok   ~$0.22 per demo cycle
#   claude-sonnet-5   $2 / $10 per Mtok   ~$0.09 per demo cycle
#   claude-haiku-4-5  $1 /  $5 per Mtok   ~$0.04 per demo cycle
#
# Pennies either way. Responses are cached on a hash of the prompt, so
# re-running the same analysis during development costs nothing after the
# first time.
LOOP_LLM_MODEL=claude-opus-5

# Cache responses on a hash of the prompt. Leave this on — during development
# you will re-run the same analysis dozens of times.
LOOP_LLM_CACHE=true

# Retries before giving up and using the deterministic fallback.
LOOP_LLM_MAX_RETRIES=3


# ─── 2. Database ────────────────────────────────────────────────────────────
#
# SQLite by default: a file, no server, nothing to install.
# For Postgres (what `docker compose up` uses):
#   postgresql+asyncpg://loop:loop@localhost:5432/loop

LOOP_DATABASE_URL=sqlite+aiosqlite:///./loop.db


# ─── 3. Frontend ────────────────────────────────────────────────────────────
#
# Read by Next.js at build time, not by the Python config.

# Where the console looks for the API.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Set to 1 to serve the console from committed fixtures instead of the network.
# This is how you develop the frontend with no Python installed at all:
#   make web-mock
# Reads work; mutations deliberately fail rather than faking success.
NEXT_PUBLIC_API_MOCK=


# ════════════════════════════════════════════════════════════════════════════
#  Everything below is already tuned. You can change it, but read the note
#  first — several of these were chosen by measurement, not by preference.
# ════════════════════════════════════════════════════════════════════════════


# ─── 4. Detection ───────────────────────────────────────────────────────────

# Idle gap that ends one task instance and starts the next.
LOOP_SESSION_GAP_MINUTES=15

# Similarity above which two workflows are treated as the same.
#
# ⚠ Chosen by sweeping against ground truth, not picked. At 0.35 the demo data
#   yields 5 clean workflows at 99.9% purity. Raising it to 0.8 fragments the
#   same data into ~227 near-identical clusters and the console becomes
#   unreadable. There is a test asserting the separation margin stays wide.
LOOP_CLUSTER_THRESHOLD=0.35

# How the three similarity signals are weighted. They must not sum above 1 —
# the embedding term takes whatever these two leave.
#   sequence = order-sensitive edit distance
#   set      = order-invariant overlap, which is what lets a high-variance
#              workflow hold together long enough to be judged at all
LOOP_SEQUENCE_WEIGHT=0.45
LOOP_SET_WEIGHT=0.30

# Above this many distinct people, a workflow becomes an organisational
# opportunity rather than one person's habit. This is also the privacy
# boundary: reporting at group level is what stops this being a monitoring
# tool, so think carefully before lowering it.
LOOP_ORG_USER_THRESHOLD=3


# ─── 5. Scoring ─────────────────────────────────────────────────────────────

# Minutes of real cost per context switch. Published estimates run 4-23; this
# is the conservative end. Reported separately from task time precisely so it
# can be argued with without moving the headline number.
LOOP_INTERRUPTION_COST_MINUTES=4.0

# An A -> B -> A application bounce within this window counts as one switch.
# A one-way move is not an interruption; coming back to what you were doing is.
LOOP_CONTEXT_SWITCH_WINDOW_MINUTES=10

# Below this automatability, LOOP recommends against automating and says why.
LOOP_DO_NOT_AUTOMATE_THRESHOLD=0.4

# Working weeks per year, for the annual-hours projection.
LOOP_WORKING_WEEKS=48


# ─── 6. Trust ladder ────────────────────────────────────────────────────────
#
# OBSERVE -> SUGGEST -> SHADOW -> ASSIST -> AUTONOMOUS

# How many recent shadow runs count towards promotion.
LOOP_SHADOW_WINDOW=5

# Average agreement required across that window.
LOOP_SHADOW_PROMOTION_THRESHOLD=0.90

# Minimum runs before promotion is possible at all, however good they were.
LOOP_SHADOW_MIN_RUNS=5

# A critical field mismatch inside this many recent runs forces a demotion.
# Bounded deliberately, so one historical failure does not trap an automation
# on a low rung forever.
LOOP_DEMOTION_LOOKBACK=3


# ─── 7. Safety ──────────────────────────────────────────────────────────────

# Mock connectors have no side effects at all.
#
# ⚠ Never set this false without real credentials configured. Note that replay
#   and shadow force mocks regardless — that guarantee lives in the engine, not
#   in this variable — but `live` mode will genuinely send email and write to
#   systems of record.
LOOP_ENABLE_MOCK_CONNECTORS=true


# ─── 8. Self-healing ────────────────────────────────────────────────────────

# Drift remappings at or above this confidence apply themselves — but only on
# steps whose effect can be undone. A rename on a step that sends email is
# never auto-applied however confident the proposal.
LOOP_PATCH_AUTO_APPLY_CONFIDENCE=0.9

# Matching human decisions needed before a branch rule is proposed.
LOOP_EXCEPTION_RULE_MIN_SAMPLES=3


# ─── 9. Synthetic data ──────────────────────────────────────────────────────
#
# The demo log is generated, not recorded. Same seed produces byte-identical
# output, so `make demo` returns to exactly the same state every time.

LOOP_SEED=42
LOOP_SEED_DAYS=90


# ─── 10. Connecting your own accounts ───────────────────────────────────────
#
# LOOP is a personal tool. It runs on your laptop, connects to your accounts,
# and has no cloud service behind it — which means it ships with no OAuth
# client secret of its own, because there is nobody to hold one.
#
# So you register a personal app once, with whichever provider you want to
# connect, and give LOOP the two values it hands you. The Sources page walks
# you through it and stores what you type in the local database; these
# variables are here for anyone who would rather keep them in a file.
#
# ⚠ Never commit a filled-in copy of this file. Copy it to `.env` — which is
#   already in .gitignore — and put the real values there.
#
# The redirect URI to register, for every provider:
#   http://localhost:8000/api/v1/connect/<provider>/callback

# Google — console.cloud.google.com, OAuth client of type "Web application".
# Reads Gmail metadata (who and when, never message bodies) and Drive file
# names.
LOOP_GOOGLE_CLIENT_ID=
LOOP_GOOGLE_CLIENT_SECRET=

# Microsoft — entra.microsoft.com, "App registrations", personal delegated
# permissions only. Reads Outlook mail headers and calendar events.
LOOP_MS_CLIENT_ID=
LOOP_MS_CLIENT_SECRET=

# Atlassian — developer.atlassian.com, an OAuth 2.0 (3LO) app.
# Reads the Jira issues assigned to you.
LOOP_ATLASSIAN_CLIENT_ID=
LOOP_ATLASSIAN_CLIENT_SECRET=

# Slack — api.slack.com/apps, a user token scope app.
# Reads your own messages, found by search rather than by reading channels.
LOOP_SLACK_CLIENT_ID=
LOOP_SLACK_CLIENT_SECRET=


# ─── 11. Where LOOP is reachable ────────────────────────────────────────────
#
# Change these only if you moved a port. The redirect URI you register with
# each provider must match LOOP_API_BASE_URL exactly, including the port.

LOOP_API_BASE_URL=http://localhost:8000
LOOP_CONSOLE_URL=http://localhost:3000
