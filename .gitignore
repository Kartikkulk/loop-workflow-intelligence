# LOOP — what never gets committed.
#
# This repository is public, and a personal account can be connected to a local
# LOOP in about two minutes. That means a working checkout holds real OAuth
# access and refresh tokens for somebody's actual mailbox. Nothing below is
# housekeeping; the database and secrets sections are the ones that matter.

# ── secrets ────────────────────────────────────────────────────────────────
# .env.example is committed and must stay empty of real values. Everything
# else named .env is a real one.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
client_secret*.json
secrets.json
token.json
*.token

# ── local database ─────────────────────────────────────────────────────────
# Once an account is connected, loop.db holds live OAuth tokens. SQLite also
# writes recent transactions to -wal and -shm sidecars, so ignoring only *.db
# leaves the newest pages — the ones most likely to hold a token just issued —
# sitting untracked-but-visible next to it.
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3

# ── dependencies ───────────────────────────────────────────────────────────
node_modules/
.venv/
venv/
__pycache__/
*.pyc
*.pyo

# ── build output ───────────────────────────────────────────────────────────
.next/
out/
dist/
build/
*.tsbuildinfo
# Assembled extensions — rebuild with `make collectors`.
collectors/dist/

# ── generated data ─────────────────────────────────────────────────────────
# The seed exports are reproducible from `make seed`, byte for byte, so
# committing them would only create merge conflicts on a file nobody reads.
apps/api/fixtures/

# Deliberately NOT ignored, both generated and both required:
#   contracts/openapi.json         — the frontend/backend contract
#   apps/web/lib/api/fixtures.json — lets the console run with no backend

# ── caches ─────────────────────────────────────────────────────────────────
.ruff_cache/
.mypy_cache/
.pytest_cache/
.turbo/
.eslintcache
coverage/
htmlcov/
.coverage

# ── test output ────────────────────────────────────────────────────────────
playwright-report/
test-results/

# ── editors and operating systems ──────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/extensions.json

# ── logs and scratch ───────────────────────────────────────────────────────
*.log
npm-debug.log*
tmp/

# Python packaging artefacts — regenerated by an editable install.
*.egg-info/
